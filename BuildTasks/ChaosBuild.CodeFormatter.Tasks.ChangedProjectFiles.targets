<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Condition="$(ChaosBuild_CodeFormatter_Tasks_Task_TF) == ''">
    <ChaosBuild_CodeFormatter_Tasks_Task_TF>$(TargetFramework)</ChaosBuild_CodeFormatter_Tasks_Task_TF>
  </PropertyGroup>

  <Import
    Project="../Repositories/ChaosBuild.CodeFormatter.Tasks.targets"
    Condition=" '$(ChaosBuild_CodeFormatter_Tasks_Path)' == '' "
    />

  <UsingTask
    TaskName="ChangedProjectFiles"
    AssemblyFile="$(SolutionDir)/$(ChaosBuild_CodeFormatter_Tasks_Path)/build/bin/$(ChaosBuild_CodeFormatter_Tasks_Task_TF)/$(ChaosBuild_CodeFormatter_Tasks_Repo).dll"
    />

  <Target
    Name="FormatChangedProjectFiles"
    BeforeTargets="BeforeBuild"
    >
    <ChangedProjectFiles
      ProjectPath="$(ProjectPath)"
      />
  </Target>

</Project>