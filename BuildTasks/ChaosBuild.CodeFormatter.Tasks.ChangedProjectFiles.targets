<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosBuild.CodeFormatter.Tasks.targets"
    Condition=" '$(ChaosBuild_CodeFormatter_Tasks_Path)' == '' "
    />

  <UsingTask
    TaskName="ChaosBuild.CodeFormatter.Tasks.Tasks.ChangedProjectFiles"
    AssemblyFile="$(SolutionDir)/$(ChaosBuild_CodeFormatter_Tasks_Path)/build/bin/$(ChaosBuild_CodeFormatter_Tasks_Repo).dll"
    />

  <Target
    Name="FormatChangedProjectFiles"
    BeforeTargets="BeforeBuild"
    >
    <ChaosBuild.CodeFormatter.Tasks.Tasks.ChangedProjectFiles
      ProjectPath="$(ProjectPath)"
      />
  </Target>

</Project>
