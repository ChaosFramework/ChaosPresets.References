<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosBuild.ProjectAnalyzer.targets"
    Condition=" '$(ChaosBuild_ProjectAnalyzer_Path)' == '' "
    />

  <UsingTask
    TaskName="MatchFilePathCase"
    AssemblyFile="$(SolutionDir)/$(ChaosBuild_ProjectAnalyzer_Path)/build/bin/$(ChaosBuild_ProjectAnalyzer_Task_TF)/$(ChaosBuild_ProjectAnalyzer_Repo).dll"
    />

  <Target
    Name="MatchFilePathCase"
    BeforeTargets="BeforeBuild"
    >
    <Message
      Importance="High"
      Text="Running MatchFilePathCase."
      />
    <MatchFilePathCase
      SolutionPath="$(SolutionPath)"
      />
  </Target>

</Project>