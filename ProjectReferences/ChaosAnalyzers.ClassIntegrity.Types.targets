<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.ClassIntegrity.Types.targets"
    Condition=" '$(ChaosAnalyzers_ClassIntegrity_Types_Path)' == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_ClassIntegrity_Types_CsProj>$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Types_Path)/$(ChaosAnalyzers_ClassIntegrity_Types_Repo).csproj</ChaosAnalyzers_ClassIntegrity_Types_CsProj>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosAnalyzers_ClassIntegrity_Types_CsProj)')">
    <ProjectReference Include="$(ChaosAnalyzers_ClassIntegrity_Types_CsProj)">
      <Project>{531C057D-4677-462A-A664-1AA5DED0367B}</Project>
      <Name>$(ChaosAnalyzers_ClassIntegrity_Types_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>