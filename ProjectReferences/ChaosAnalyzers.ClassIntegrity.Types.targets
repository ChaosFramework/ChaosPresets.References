<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosAnalyzers_ClassIntegrity_Types_Repo>ChaosAnalyzers.ClassIntegrity.Types</ChaosAnalyzers_ClassIntegrity_Types_Repo>
    <ChaosAnalyzers_ClassIntegrity_Types_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosAnalyzers_ClassIntegrity_Types_Repo)$(SubmoduleRefRegex_Suffix)</ChaosAnalyzers_ClassIntegrity_Types_Regex>
    <ChaosAnalyzers_ClassIntegrity_Types_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosAnalyzers_ClassIntegrity_Types_Regex)'))</ChaosAnalyzers_ClassIntegrity_Types_Path>
    <ChaosAnalyzers_ClassIntegrity_Types_FullPath>$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Types_Path)/$(ChaosAnalyzers_ClassIntegrity_Types_Repo).csproj</ChaosAnalyzers_ClassIntegrity_Types_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosAnalyzers_ClassIntegrity_Types_FullPath)')">
    <ProjectReference Include="$(ChaosAnalyzers_ClassIntegrity_Types_FullPath)">
      <Project>{531C057D-4677-462A-A664-1AA5DED0367B}</Project>
      <Name>$(ChaosAnalyzers_ClassIntegrity_Types_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>