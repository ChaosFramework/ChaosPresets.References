<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Input_Windows_RawInput_DeviceList_Repo>ChaosFramework.Input.Windows.RawInput.DeviceList</ChaosFramework_Input_Windows_RawInput_DeviceList_Repo>
    <ChaosFramework_Input_Windows_RawInput_DeviceList_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Input_Windows_RawInput_DeviceList_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Input_Windows_RawInput_DeviceList_Regex>
    <ChaosFramework_Input_Windows_RawInput_DeviceList_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Input_Windows_RawInput_DeviceList_Regex)'))</ChaosFramework_Input_Windows_RawInput_DeviceList_Path>
    <ChaosFramework_Input_Windows_RawInput_DeviceList_FullPath>$(SolutionDir)/$(ChaosFramework_Input_Windows_RawInput_DeviceList_Path)/$(ChaosFramework_Input_Windows_RawInput_DeviceList_Repo).csproj</ChaosFramework_Input_Windows_RawInput_DeviceList_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Input_Windows_RawInput_DeviceList_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Input_Windows_RawInput_DeviceList_FullPath)">
      <Project>{49ABF8D8-67B2-4B17-8D23-325D91D6FF65}</Project>
      <Name>$(ChaosFramework_Input_Windows_RawInput_DeviceList_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>