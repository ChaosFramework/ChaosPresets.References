<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.targets"
    Condition=" '$(ChaosAnalyzers_Path)' == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_CsProj>$(SolutionDir)/$(ChaosAnalyzers_Path)/$(ChaosAnalyzers_Repo).csproj</ChaosAnalyzers_CsProj>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosAnalyzers_CsProj)')">
    <ProjectReference Include="$(ChaosAnalyzers_CsProj)">
      <Project>{5AD17D0E-56B3-499D-920C-EE08E40482E1}</Project>
      <Name>$(ChaosAnalyzers_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>