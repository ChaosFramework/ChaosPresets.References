<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosUtil_Primitives_Repo>ChaosUtil.Primitives</ChaosUtil_Primitives_Repo>
    <ChaosUtil_Primitives_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosUtil_Primitives_Repo)$(SubmoduleRefRegex_Suffix)</ChaosUtil_Primitives_Regex>
    <ChaosUtil_Primitives_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosUtil_Primitives_Regex)'))</ChaosUtil_Primitives_Path>
    <ChaosUtil_Primitives_FullPath>$(SolutionDir)/$(ChaosUtil_Primitives_Path)/$(ChaosUtil_Primitives_Repo).csproj</ChaosUtil_Primitives_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosUtil_Primitives_FullPath)')">
    <ProjectReference Include="$(ChaosUtil_Primitives_FullPath)">
      <Project>{7A7A6479-30EC-4329-A29F-31E7644E19EC}</Project>
      <Name>$(ChaosUtil_Primitives_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
