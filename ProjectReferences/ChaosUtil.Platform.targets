<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosUtil_Platform_Repo>ChaosUtil.Platform</ChaosUtil_Platform_Repo>
    <ChaosUtil_Platform_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosUtil_Platform_Repo)$(SubmoduleRefRegex_Suffix)</ChaosUtil_Platform_Regex>
    <ChaosUtil_Platform_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosUtil_Platform_Regex)'))</ChaosUtil_Platform_Path>
    <ChaosUtil_Platform_FullPath>$(SolutionDir)/$(ChaosUtil_Platform_Path)/$(ChaosUtil_Platform_Repo).csproj</ChaosUtil_Platform_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosUtil_Platform_FullPath)')">
    <ProjectReference Include="$(ChaosUtil_Platform_FullPath)">
      <Project>{B6470CE7-0195-4EEF-80AF-ACD43AA1FCF2}</Project>
      <Name>$(ChaosUtil_Platform_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>