<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Platform_WinForms_Repo>ChaosFramework.Platform.WinForms</ChaosFramework_Platform_WinForms_Repo>
    <ChaosFramework_Platform_WinForms_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Platform_WinForms_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Platform_WinForms_Regex>
    <ChaosFramework_Platform_WinForms_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Platform_WinForms_Regex)'))</ChaosFramework_Platform_WinForms_Path>
    <ChaosFramework_Platform_WinForms_FullPath>$(SolutionDir)/$(ChaosFramework_Platform_WinForms_Path)/$(ChaosFramework_Platform_WinForms_Repo).csproj</ChaosFramework_Platform_WinForms_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Platform_WinForms_FullPath)')">
    <ProjectReference
      Include="$(ChaosFramework_Platform_WinForms_FullPath)"
      Condition="'$(OS)'=='Windows'"
      >
      <Project>{EF4A42BB-C10C-4B68-8F61-CAABB10DF12E}</Project>
      <Name>$(ChaosFramework_Platform_WinForms_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
