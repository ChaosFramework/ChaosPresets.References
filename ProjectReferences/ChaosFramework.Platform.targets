<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Platform_Repo>ChaosFramework.Platform</ChaosFramework_Platform_Repo>
    <ChaosFramework_Platform_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Platform_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Platform_Regex>
    <ChaosFramework_Platform_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Platform_Regex)'))</ChaosFramework_Platform_Path>
    <ChaosFramework_Platform_FullPath>$(SolutionDir)/$(ChaosFramework_Platform_Path)/$(ChaosFramework_Platform_Repo).csproj</ChaosFramework_Platform_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Platform_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Platform_FullPath)">
      <Project>{6CD6109D-B63A-4A08-B516-D9CE3C3F0097}</Project>
      <Name>$(ChaosFramework_Platform_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
