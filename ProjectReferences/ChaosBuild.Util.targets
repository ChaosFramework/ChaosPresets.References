<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosBuild_Util_Repo>ChaosBuild.Util</ChaosBuild_Util_Repo>
    <ChaosBuild_Util_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosBuild_Util_Repo)$(SubmoduleRefRegex_Suffix)</ChaosBuild_Util_Regex>
    <ChaosBuild_Util_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosBuild_Util_Regex)'))</ChaosBuild_Util_Path>
    <ChaosBuild_Util_FullPath>$(SolutionDir)/$(ChaosBuild_Util_Path)/$(ChaosBuild_Util_Repo).csproj</ChaosBuild_Util_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosBuild_Util_FullPath)')">
    <ProjectReference Include="$(ChaosBuild_Util_FullPath)">
      <Project>{88E46758-7074-48C2-807A-5F36796B6BAE}</Project>
      <Name>$(ChaosBuild_Util_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>