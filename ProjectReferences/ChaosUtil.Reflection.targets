<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosUtil_Reflection_Repo>ChaosUtil.Reflection</ChaosUtil_Reflection_Repo>
    <ChaosUtil_Reflection_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosUtil_Reflection_Repo)$(SubmoduleRefRegex_Suffix)</ChaosUtil_Reflection_Regex>
    <ChaosUtil_Reflection_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosUtil_Reflection_Regex)'))</ChaosUtil_Reflection_Path>
    <ChaosUtil_Reflection_FullPath>$(SolutionDir)/$(ChaosUtil_Reflection_Path)/$(ChaosUtil_Reflection_Repo).$(ProjectStyle).csproj</ChaosUtil_Reflection_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosUtil_Reflection_FullPath)')">
    <ProjectReference Include="$(ChaosUtil_Reflection_FullPath)">
      <Project>{53B2266C-F2B0-41A9-8EF7-F89FD6BC40FF}</Project>
      <Name>$(ChaosUtil_Reflection_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>