<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosUtil_Debug_Repo>ChaosUtil.Debug</ChaosUtil_Debug_Repo>
    <ChaosUtil_Debug_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosUtil_Debug_Repo)$(SubmoduleRefRegex_Suffix)</ChaosUtil_Debug_Regex>
    <ChaosUtil_Debug_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosUtil_Debug_Regex)'))</ChaosUtil_Debug_Path>
    <ChaosUtil_Debug_FullPath>$(SolutionDir)/$(ChaosUtil_Debug_Path)/$(ChaosUtil_Debug_Repo).csproj</ChaosUtil_Debug_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosUtil_Debug_FullPath)')">
    <ProjectReference Include="$(ChaosUtil_Debug_FullPath)">
      <Project>{655D220A-B111-462A-B5CA-FBD1750D5CB3}</Project>
      <Name>$(ChaosUtil_Debug_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
