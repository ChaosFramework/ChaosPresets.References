<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Graphics_OpenGL_Repo>ChaosFramework.Graphics.OpenGL</ChaosFramework_Graphics_OpenGL_Repo>
    <ChaosFramework_Graphics_OpenGL_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Graphics_OpenGL_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Graphics_OpenGL_Regex>
    <ChaosFramework_Graphics_OpenGL_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Graphics_OpenGL_Regex)'))</ChaosFramework_Graphics_OpenGL_Path>
    <ChaosFramework_Graphics_OpenGL_FullPath>$(SolutionDir)/$(ChaosFramework_Graphics_OpenGL_Path)/$(ChaosFramework_Graphics_OpenGL_Repo).csproj</ChaosFramework_Graphics_OpenGL_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Graphics_OpenGL_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Graphics_OpenGL_FullPath)">
      <Project>{3C8E5ADC-0E53-40FA-B6F3-3B9DE5996D79}</Project>
      <Name>$(ChaosFramework_Graphics_OpenGL_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>