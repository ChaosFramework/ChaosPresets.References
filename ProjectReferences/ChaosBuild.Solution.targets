<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosBuild_Solution_Repo>ChaosBuild.Solution</ChaosBuild_Solution_Repo>
    <ChaosBuild_Solution_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosBuild_Solution_Repo)$(SubmoduleRefRegex_Suffix)</ChaosBuild_Solution_Regex>
    <ChaosBuild_Solution_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosBuild_Solution_Regex)'))</ChaosBuild_Solution_Path>
    <ChaosBuild_Solution_FullPath>$(SolutionDir)/$(ChaosBuild_Solution_Path)/$(ChaosBuild_Solution_Repo).csproj</ChaosBuild_Solution_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosBuild_Solution_FullPath)')">
    <ProjectReference Include="$(ChaosBuild_Solution_FullPath)">
      <Project>{D68A73B8-28BE-42CD-908F-FCF2FE674912}</Project>
      <Name>$(ChaosBuild_Solution_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>