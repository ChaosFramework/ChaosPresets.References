<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_IO_Repo>ChaosFramework.IO</ChaosFramework_IO_Repo>
    <ChaosFramework_IO_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_IO_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_IO_Regex>
    <ChaosFramework_IO_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_IO_Regex)'))</ChaosFramework_IO_Path>
    <ChaosFramework_IO_FullPath>$(SolutionDir)/$(ChaosFramework_IO_Path)/$(ChaosFramework_IO_Repo).csproj</ChaosFramework_IO_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_IO_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_IO_FullPath)">
      <Project>{922D65DE-8FF3-47CE-9521-36B583C73BAA}</Project>
      <Name>$(ChaosFramework_IO_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>