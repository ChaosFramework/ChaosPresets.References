<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Physics_Repo>ChaosFramework.Physics</ChaosFramework_Physics_Repo>
    <ChaosFramework_Physics_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Physics_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Physics_Regex>
    <ChaosFramework_Physics_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Physics_Regex)'))</ChaosFramework_Physics_Path>
    <ChaosFramework_Physics_FullPath>$(SolutionDir)/$(ChaosFramework_Physics_Path)/$(ChaosFramework_Physics_Repo).csproj</ChaosFramework_Physics_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Physics_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Physics_FullPath)">
      <Project>{310DB2DF-9F43-4ABA-978D-6EFF4DE58C92}</Project>
      <Name>$(ChaosFramework_Physics_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
