<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Collections_Repo>ChaosFramework.Collections</ChaosFramework_Collections_Repo>
    <ChaosFramework_Collections_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Collections_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Collections_Regex>
    <ChaosFramework_Collections_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Collections_Regex)'))</ChaosFramework_Collections_Path>
    <ChaosFramework_Collections_FullPath>$(SolutionDir)/$(ChaosFramework_Collections_Path)/$(ChaosFramework_Collections_Repo).$(ProjectStyle).csproj</ChaosFramework_Collections_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Collections_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Collections_FullPath)">
      <Project>{A1024CC0-A665-4602-A422-8E1F88F5E3AF}</Project>
      <Name>$(ChaosFramework_Collections_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>