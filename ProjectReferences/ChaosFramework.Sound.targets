<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Sound_Repo>ChaosFramework.Sound</ChaosFramework_Sound_Repo>
    <ChaosFramework_Sound_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Sound_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Sound_Regex>
    <ChaosFramework_Sound_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Sound_Regex)'))</ChaosFramework_Sound_Path>
    <ChaosFramework_Sound_FullPath>$(SolutionDir)/$(ChaosFramework_Sound_Path)/$(ChaosFramework_Sound_Repo).csproj</ChaosFramework_Sound_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Sound_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Sound_FullPath)">
      <Project>{1F342087-8022-41A6-8E4D-2A3598BA1145}</Project>
      <Name>$(ChaosFramework_Sound_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>