<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Input_RawInput_Sharp_Repo>ChaosFramework.Input.RawInput.Sharp</ChaosFramework_Input_RawInput_Sharp_Repo>
    <ChaosFramework_Input_RawInput_Sharp_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Input_RawInput_Sharp_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Input_RawInput_Sharp_Regex>
    <ChaosFramework_Input_RawInput_Sharp_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Input_RawInput_Sharp_Regex)'))</ChaosFramework_Input_RawInput_Sharp_Path>
    <ChaosFramework_Input_RawInput_Sharp_FullPath>$(SolutionDir)/$(ChaosFramework_Input_RawInput_Sharp_Path)/$(ChaosFramework_Input_RawInput_Sharp_Repo).csproj</ChaosFramework_Input_RawInput_Sharp_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Input_RawInput_Sharp_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Input_RawInput_Sharp_FullPath)">
      <Project>{6ACF9FFF-0B0A-4F49-A541-400D1F58ABFB}</Project>
      <Name>$(ChaosFramework_Input_RawInput_Sharp_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>