<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosUtil_Serialization_Repo>ChaosUtil.Serialization</ChaosUtil_Serialization_Repo>
    <ChaosUtil_Serialization_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosUtil_Serialization_Repo)$(SubmoduleRefRegex_Suffix)</ChaosUtil_Serialization_Regex>
    <ChaosUtil_Serialization_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosUtil_Serialization_Regex)'))</ChaosUtil_Serialization_Path>
    <ChaosUtil_Serialization_FullPath>$(SolutionDir)/$(ChaosUtil_Serialization_Path)/$(ChaosUtil_Serialization_Repo).csproj</ChaosUtil_Serialization_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosUtil_Serialization_FullPath)')">
    <ProjectReference Include="$(ChaosUtil_Serialization_FullPath)">
      <Project>{004E9F33-CF5E-4EB6-A08C-3CBB0AB08E72}</Project>
      <Name>$(ChaosUtil_Serialization_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
