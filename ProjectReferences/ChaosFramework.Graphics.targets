<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosFramework_Graphics_Repo>ChaosFramework.Graphics</ChaosFramework_Graphics_Repo>
    <ChaosFramework_Graphics_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosFramework_Graphics_Repo)$(SubmoduleRefRegex_Suffix)</ChaosFramework_Graphics_Regex>
    <ChaosFramework_Graphics_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosFramework_Graphics_Regex)'))</ChaosFramework_Graphics_Path>
    <ChaosFramework_Graphics_FullPath>$(SolutionDir)/$(ChaosFramework_Graphics_Path)/$(ChaosFramework_Graphics_Repo).csproj</ChaosFramework_Graphics_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosFramework_Graphics_FullPath)')">
    <ProjectReference Include="$(ChaosFramework_Graphics_FullPath)">
      <Project>{7088DB22-E437-4DBC-9F8C-0F433ACE0558}</Project>
      <Name>$(ChaosFramework_Graphics_Repo)</Name>
    </ProjectReference>
  </ItemGroup>

</Project>