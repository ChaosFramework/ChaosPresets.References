<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.ClassIntegrity.targets"
    Condition=" '$(ChaosAnalyzers_ClassIntegrity_Path)' == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_ClassIntegrity_Include>$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Path)/export/Include.targets</ChaosAnalyzers_ClassIntegrity_Include>
  </PropertyGroup>

  <Import
    Project="$(ChaosAnalyzers_ClassIntegrity_Include)"
    Condition="Exists('$(ChaosAnalyzers_ClassIntegrity_Include)')"
    />

</Project>