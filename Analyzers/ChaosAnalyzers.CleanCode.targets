<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import
    Project="../Repositories/ChaosAnalyzers.CleanCode.targets"
    Condition=" '$(ChaosAnalyzers_CleanCode_Path)' == '' "
    />

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)/$(ChaosAnalyzers_CleanCode_Path)/$(ChaosAnalyzers_CleanCode_Repo).csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
