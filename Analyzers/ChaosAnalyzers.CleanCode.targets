<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.CleanCode.targets"
    Condition=" '$(ChaosAnalyzers_CleanCode_Path)' == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_CleanCode_Include>$(SolutionDir)/$(ChaosAnalyzers_CleanCode_Path)/export/Include.targets</ChaosAnalyzers_CleanCode_Include>
  </PropertyGroup>

  <Import
    Project="$(ChaosAnalyzers_CleanCode_Include)"
    Condition="Exists('$(ChaosAnalyzers_CleanCode_Include)')"
    />

</Project>