<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import
    Project="../Repositories/ChaosAnalyzers.CleanCode.targets"
    Condition=" '$(ChaosAnalyzers_CleanCode_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosAnalyzers_CleanCode_Analyzer_TF)' == ''">
    <ChaosAnalyzers_CleanCode_Analyzer_TF>$(TargetFramework)</ChaosAnalyzers_CleanCode_Analyzer_TF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)/$(ChaosAnalyzers_CleanCode_Path)/$(ChaosAnalyzers_CleanCode_Repo).csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetTargetFramework>TargetFramework=$(ChaosAnalyzers_CleanCode_Analyzer_TF)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

</Project>
