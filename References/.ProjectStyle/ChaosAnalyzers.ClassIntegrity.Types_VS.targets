<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ChaosAnalyzers_ClassIntegrity_Types_Ref>$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Types_Path)/build/bin/$(ChaosAnalyzers_ClassIntegrity_Types_Ref_TF)/$(ChaosAnalyzers_ClassIntegrity_Types_Repo).dll</ChaosAnalyzers_ClassIntegrity_Types_Ref>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosAnalyzers_ClassIntegrity_Types_Ref)')">
    <Reference Include="$(ChaosAnalyzers_ClassIntegrity_Types_Repo)">
      <HintPath>$(ChaosAnalyzers_ClassIntegrity_Types_Ref)</HintPath>
    </Reference>
  </ItemGroup>

</Project>