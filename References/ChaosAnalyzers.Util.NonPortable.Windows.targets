<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.Util.NonPortable.Windows.targets"
    Condition="$(ChaosAnalyzers_Util_NonPortable_Windows_Path) == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_Util_NonPortable_Windows_Ref>$(SolutionDir)/$(ChaosAnalyzers_Util_NonPortable_Windows_Path)/build/bin/$(ChaosAnalyzers_Util_NonPortable_Windows_Repo).dll</ChaosAnalyzers_Util_NonPortable_Windows_Ref>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosAnalyzers_Util_NonPortable_Windows_Ref)')">
    <Reference Include="$(ChaosAnalyzers_Util_NonPortable_Windows_Repo)">
      <HintPath>$(ChaosAnalyzers_Util_NonPortable_Windows_Ref)</HintPath>
    </Reference>
  </ItemGroup>

</Project>