<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosAnalyzers_Util_Repo>ChaosAnalyzers.Util.NonPortable.Windows</ChaosAnalyzers_Util_Repo>
    <ChaosAnalyzers_Util_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosAnalyzers_Util_Repo)$(SubmoduleRefRegex_Suffix)</ChaosAnalyzers_Util_Regex>
    <ChaosAnalyzers_Util_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosAnalyzers_Util_Regex)'))</ChaosAnalyzers_Util_Path>
    <ChaosAnalyzers_Util_FullPath>$(SolutionDir)/$(ChaosAnalyzers_Util_Path)/build/bin/$(ChaosAnalyzers_Util_Repo).dll</ChaosAnalyzers_Util_FullPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChaosAnalyzers_Util_FullPath)')">
    <Reference Include="$(ChaosAnalyzers_Util_Repo)">
      <HintPath>$(ChaosAnalyzers_Util_FullPath)</HintPath>
    </Reference>
  </ItemGroup>

</Project>