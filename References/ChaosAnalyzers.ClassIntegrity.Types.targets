<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.ClassIntegrity.Types.targets"
    Condition="'$(ChaosAnalyzers_ClassIntegrity_Types_Path)' == ''"
    />

  <PropertyGroup Condition="'$(ChaosAnalyzers_ClassIntegrity_Types_Ref_TF)' == ''">
    <ChaosAnalyzers_ClassIntegrity_Types_Ref_TF>$(TargetFramework)</ChaosAnalyzers_ClassIntegrity_Types_Ref_TF>
  </PropertyGroup>

  <Import Project="./.ProjectStyle/ChaosAnalyzers.ClassIntegrity.Types_$(ProjectStyle).targets" />

</Project>