<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.targets"
    Condition=" '$(ChaosAnalyzers_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosAnalyzers_Analyzer_TF)' == ''">
    <ChaosAnalyzers_Analyzer_TF>$(TargetFramework)</ChaosAnalyzers_Analyzer_TF>
  </PropertyGroup>

  <Import Project="./.ProjectStyle/ChaosAnalyzers_$(ProjectStyle).targets" />

</Project>