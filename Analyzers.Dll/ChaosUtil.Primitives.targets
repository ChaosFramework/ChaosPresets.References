<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosUtil.Primitives.targets"
    Condition=" '$(ChaosUtil_Primitives_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosUtil_Primitives_Analyzer_TF)' == ''">
    <ChaosUtil_Primitives_Analyzer_TF>$(TargetFramework)</ChaosUtil_Primitives_Analyzer_TF>
  </PropertyGroup>

  <Import Project="./.ProjectStyle/ChaosUtil.Primitives_$(ProjectStyle).targets" />

</Project>