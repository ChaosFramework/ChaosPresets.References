<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ChaosAnalyzers_Util_NonPortable_Windows_Analyzer>$(SolutionDir)/$(ChaosAnalyzers_Util_NonPortable_Windows_Path)/build/bin/$(ChaosAnalyzers_Util_NonPortable_Windows_Analyzer_TF)/$(ChaosAnalyzers_Util_NonPortable_Windows_Repo).dll</ChaosAnalyzers_Util_NonPortable_Windows_Analyzer>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer
      Include="$(ChaosAnalyzers_Util_NonPortable_Windows_Analyzer)"
      Condition="Exists('$(ChaosAnalyzers_Util_NonPortable_Windows_Analyzer)')"
      />
  </ItemGroup>

</Project>