<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ChaosGenerators_Types_Analyzer>$(SolutionDir)/$(ChaosGenerators_Path)/$(ChaosGenerators_Repo).Types/build/bin/$(ChaosGenerators_Types_Analyzer_TF)/$(ChaosGenerators_Repo).Types.dll</ChaosGenerators_Types_Analyzer>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer
      Include="$(ChaosGenerators_Types_Analyzer)"
      Condition="Exists('$(ChaosGenerators_Types_Analyzer)')"
      />
  </ItemGroup>

</Project>