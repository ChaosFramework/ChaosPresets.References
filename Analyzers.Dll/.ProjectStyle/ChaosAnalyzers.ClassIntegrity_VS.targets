<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ChaosAnalyzers_ClassIntegrity_Analyzer>$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Path)/build/bin/$(ChaosAnalyzers_ClassIntegrity_Analyzer_TF)/$(ChaosAnalyzers_ClassIntegrity_Repo).dll</ChaosAnalyzers_ClassIntegrity_Analyzer>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer
      Include="$(ChaosAnalyzers_ClassIntegrity_Analyzer)"
      Condition="Exists('$(ChaosAnalyzers_ClassIntegrity_Analyzer)')"
      />
  </ItemGroup>

</Project>