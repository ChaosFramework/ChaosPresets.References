<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.Util.NonPortable.Windows.targets"
    Condition=" '$(ChaosAnalyzers_Util_NonPortable_Windows_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosAnalyzers_Util_NonPortable_Windows_Analyzer_TF)' == ''">
    <ChaosAnalyzers_Util_NonPortable_Windows_Analyzer_TF>$(TargetFramework)</ChaosAnalyzers_Util_NonPortable_Windows_Analyzer_TF>
  </PropertyGroup>

  <Import Project="./.ProjectStyle/ChaosAnalyzers.Util.NonPortable.Windows_$(ProjectStyle).targets" />

</Project>