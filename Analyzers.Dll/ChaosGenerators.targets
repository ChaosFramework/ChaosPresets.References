<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosGenerators.targets"
    Condition=" '$(ChaosGenerators_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosGenerators_Analyzer_TF)' == ''">
    <ChaosGenerators_Analyzer_TF>$(TargetFramework)</ChaosGenerators_Analyzer_TF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(SolutionDir)/$(ChaosGenerators_Path)/$(ChaosGenerators_Repo)/$(ChaosGenerators_Repo).csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=$(ChaosGenerators_Analyzer_TF)"
      />
  </ItemGroup>

</Project>