<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.ClassIntegrity.Types.targets"
    Condition=" '$(ChaosAnalyzers_ClassIntegrity_Types_Path)' == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_ClassIntegrity_Types_Analyzer>$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Types_Path)/build/bin/$(ChaosAnalyzers_ClassIntegrity_Types_Repo).dll</ChaosAnalyzers_ClassIntegrity_Types_Analyzer>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer
      Include="$(ChaosAnalyzers_ClassIntegrity_Types_Analyzer)"
      Condition="Exists('$(ChaosAnalyzers_ClassIntegrity_Types_Analyzer)')"
      />
  </ItemGroup>

</Project>