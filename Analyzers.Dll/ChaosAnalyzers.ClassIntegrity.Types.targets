<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.ClassIntegrity.Types.targets"
    Condition=" '$(ChaosAnalyzers_ClassIntegrity_Types_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosAnalyzers_ClassIntegrity_Types_Analyzer_TF)' == ''">
    <ChaosAnalyzers_ClassIntegrity_Types_Analyzer_TF>$(TargetFramework)</ChaosAnalyzers_ClassIntegrity_Types_Analyzer_TF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(SolutionDir)/$(ChaosAnalyzers_ClassIntegrity_Types_Path)/$(ChaosAnalyzers_ClassIntegrity_Types_Repo).csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=$(ChaosAnalyzers_ClassIntegrity_Types_Analyzer_TF)"
      />
  </ItemGroup>

</Project>
