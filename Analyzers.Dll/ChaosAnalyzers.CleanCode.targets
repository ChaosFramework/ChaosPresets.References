<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.CleanCode.targets"
    Condition=" '$(ChaosAnalyzers_CleanCode_Path)' == '' "
    />

  <PropertyGroup Condition="'$(ChaosAnalyzers_CleanCode_Analyzer_TF)' == ''">
    <ChaosAnalyzers_CleanCode_Analyzer_TF>$(TargetFramework)</ChaosAnalyzers_CleanCode_Analyzer_TF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(SolutionDir)/$(ChaosAnalyzers_CleanCode_Path)/$(ChaosAnalyzers_CleanCode_Repo).csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=$(ChaosAnalyzers_CleanCode_Analyzer_TF)"
      />
  </ItemGroup>

</Project>
