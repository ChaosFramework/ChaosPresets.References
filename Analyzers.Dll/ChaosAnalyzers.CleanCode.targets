<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../Repositories/ChaosAnalyzers.CleanCode.targets"
    Condition=" '$(ChaosAnalyzers_CleanCode_Path)' == '' "
    />

  <PropertyGroup>
    <ChaosAnalyzers_CleanCode_Analyzer>$(SolutionDir)/$(ChaosAnalyzers_CleanCode_Path)/build/bin/$(ChaosAnalyzers_CleanCode_Repo).dll</ChaosAnalyzers_CleanCode_Analyzer>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer
      Include="$(ChaosAnalyzers_CleanCode_Analyzer)"
      Condition="Exists('$(ChaosAnalyzers_CleanCode_Analyzer)')"
      />
  </ItemGroup>

</Project>