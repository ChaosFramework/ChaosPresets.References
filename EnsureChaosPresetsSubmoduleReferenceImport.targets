<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- A property that can be used to avoid multiple imports of this .targets file. -->
  <PropertyGroup>
    <EnsureChaosPresetsSubmoduleReferenceImported>True</EnsureChaosPresetsSubmoduleReferenceImported>
  </PropertyGroup>

  <Target
    Name="EnsureChaosPresetsSubmoduleReferenceImport"
    BeforeTargets="BeforeBuild"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    >
    <Error Text="Import 'ChaosPresets.Targets/Paths/References/Submodule.targets' before importing reference targets." />
  </Target>

</Project>