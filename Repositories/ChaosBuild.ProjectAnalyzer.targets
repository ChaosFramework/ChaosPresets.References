<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosBuild_ProjectAnalyzer_Repo>ChaosBuild.ProjectAnalyzer</ChaosBuild_ProjectAnalyzer_Repo>
    <ChaosBuild_ProjectAnalyzer_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosBuild_ProjectAnalyzer_Repo)$(SubmoduleRefRegex_Suffix)</ChaosBuild_ProjectAnalyzer_Regex>
    <ChaosBuild_ProjectAnalyzer_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosBuild_ProjectAnalyzer_Regex)'))</ChaosBuild_ProjectAnalyzer_Path>
  </PropertyGroup>

</Project>