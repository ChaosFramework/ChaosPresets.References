<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosGenerators_Repo>ChaosGenerators</ChaosGenerators_Repo>
    <ChaosGenerators_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosGenerators_Repo)$(SubmoduleRefRegex_Suffix)</ChaosGenerators_Regex>
    <ChaosGenerators_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosGenerators_Regex)'))</ChaosGenerators_Path>
  </PropertyGroup>

</Project>