<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import
    Project="../SubmoduleReference.targets"
    Condition=" '$(SubmoduleRefRegex_Prefix)' == '' "
    />

  <PropertyGroup Condition=" '$(SubmoduleRefRegex_Prefix)' != '' ">
    <ChaosAnalyzers_Util_NonPortable_Windows_Repo>ChaosAnalyzers.Util.NonPortable.Windows</ChaosAnalyzers_Util_NonPortable_Windows_Repo>
    <ChaosAnalyzers_Util_NonPortable_Windows_Regex>$(SubmoduleRefRegex_Prefix)$(ChaosAnalyzers_Util_NonPortable_Windows_Repo)$(SubmoduleRefRegex_Suffix)</ChaosAnalyzers_Util_NonPortable_Windows_Regex>
    <ChaosAnalyzers_Util_NonPortable_Windows_Path>$([System.Text.RegularExpressions.Regex]::Match('$(SubmoduleIndex)','$(ChaosAnalyzers_Util_NonPortable_Windows_Regex)'))</ChaosAnalyzers_Util_NonPortable_Windows_Path>
  </PropertyGroup>

</Project>